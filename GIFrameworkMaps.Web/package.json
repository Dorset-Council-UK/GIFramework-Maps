{
  "name": "giframeworkmaps",
  "version": "1.0.0",
  "description": "A .NET based web map built with OpenLayers and Bootstrap",
  "repository": "https://github.com/Dorset-Council-UK/GIFramework-Maps",
  "license": "MIT",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "bun run --parallel build:map build:management build:theme",
    "build:dev": "bun run --parallel build:map:dev build:management:dev build:theme:dev",
    "copy:cesium": "bun ./Scripts/copyCesiumAssets.ts",
    "build:map": "bun run copy:cesium && bun build ./Scripts/app.ts --outdir ./wwwroot/js --entry-naming bundle.[ext] --target browser --minify --sourcemap=external",
    "build:map:dev": "bun run copy:cesium && bun build ./Scripts/app.ts --outdir ./wwwroot/js --entry-naming bundle.[ext] --target browser --sourcemap=inline",
    "build:management": "bun build ./Scripts/Management/management.ts --outdir ./wwwroot/js/management --entry-naming management.[ext] --target browser --minify --sourcemap=external",
    "build:management:dev": "bun build ./Scripts/Management/management.ts --outdir ./wwwroot/js/management --entry-naming management.[ext] --target browser --sourcemap=inline",
    "build:theme": "bun build ./Scripts/ThemeSwitcher.ts --outdir ./wwwroot/js --entry-naming ThemeSwitcher.[ext] --target browser --format iife --minify --sourcemap=external",
    "build:theme:dev": "bun build ./Scripts/ThemeSwitcher.ts --outdir ./wwwroot/js --entry-naming ThemeSwitcher.[ext] --target browser --format iife --sourcemap=inline",
    "watch:map": "bun run copy:cesium && bun build ./Scripts/app.ts --outdir ./wwwroot/js --entry-naming bundle.[ext] --target browser --sourcemap=inline --watch --no-clear-screen",
    "watch:management": "bun build ./Scripts/Management/management.ts --outdir ./wwwroot/js/management --entry-naming management.[ext] --target browser --sourcemap=inline --watch --no-clear-screen",
    "watch:theme": "bun build ./Scripts/ThemeSwitcher.ts --outdir ./wwwroot/js --entry-naming ThemeSwitcher.[ext] --target browser --format iife --sourcemap=inline --watch --no-clear-screen",
    "watch": "bun run --parallel watch:map watch:management watch:theme",
    "watch:custom": "bun run bun.build.ts --dev --watch",
    "audit": "bun audit",
    "outdated": "bun outdated",
    "lint": "echo \"bunx eslint temporarily disabled due to lack of TypeScript 7 support.\"",
    "prettier": "bunx prettier . --write",
    "watch:prettier": "bunx onchange \"Scripts/*.ts\" \"wwwroot/css/*.css\" -- prettier --write --ignore-unknown {{changed}}"
  },
  "dependencies": {
    "@camptocamp/ogc-client": "1.3.1-dev.edb3244",
    "@microsoft/applicationinsights-web": "3.4.3",
    "@microsoft/signalr": "10.0.11",
    "@popperjs/core": "2.11.8",
    "@turf/boolean-intersects": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@turf/unkink-polygon": "7.4.0",
    "accessible-autocomplete": "3.0.1",
    "bootstrap": "5.3.8",
    "cesium": "1.144.0",
    "dompurify": "3.4.14",
    "fontoxpath": "3.34.0",
    "fuse.js": "7.5.0",
    "geostyler-openlayers-parser": "5.7.1",
    "geostyler-legend": "5.2.1",
    "jspdf": "4.2.1",
    "lodash.debounce": "4.0.8",
    "luxon": "3.7.2",
    "nunjucks": "3.2.4",
    "ol": "10.10.0",
    "ol-contextmenu": "6.0.1",
    "ol-mapbox-style": "13.4.2",
    "ol-pmtiles": "2.0.2",
    "olcs": "2.23.1",
    "proj4": "2.21.0",
    "shepherd.js": "13.0.3",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@types/bootstrap": "5.2.11",
    "@types/bun": "1.4.0",
    "@types/dom-screen-wake-lock": "1.0.3",
    "@types/lodash.debounce": "4.0.9",
    "@types/luxon": "3.7.4",
    "@types/nunjucks": "3.2.6",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "onchange": "7.1.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  },
  "-vs-binding": {
    "ProjectOpened": [
      "watch"
    ]
  }
}